Program
  FuncDecl fatorial(n: int): int
    Block
      VarDecl resultado: int
        IntLit 1
      For
        Init
          VarDecl i: int
            IntLit 1
        Cond
          Binary <=
            Var i
            Var n
        Passo
          Assign i
            Binary +
              Var i
              IntLit 1
        Block
          Assign resultado
            Binary *
              Var resultado
              Var i
      Return
        Var resultado
  Print
    StringLit "Digite um número para calcular o fatorial:"
  VarDecl numero: int
  Input numero
  VarDecl fat: int
    Call fatorial
      Var numero
  Print
    Binary +
      Binary +
        Binary +
          StringLit "O fatorial de "
          Var numero
        StringLit " é "
      Var fat
