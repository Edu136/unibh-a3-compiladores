// Exemplo do modo mineiro. Compile com:
//   macsc.bat exemplos\mineiro.macs --uai --exe
//   exemplos\mineiro.exe

// o fatorial do enunciado, em mineirês
causo fatorial(n: int): int {
    trem resultado: int = 1;
    pra (trem i: int = 1; i <= n; i++) {
        resultado = resultado * i;
    }
    devolve resultado;
}

causo podeEntrar(idade: int): bool {
    se (idade >= 18) {
        devolve bao;
    }
    devolve nem;
}

trem idade: int;
prosa("Quantos anos ocê tem?");
escuta(idade);

se (podeEntrar(idade)) {
    prosa("pode entrar, sô");
} senao {
    prosa("ainda não, uai");
}

prosa("Digite um número para calcular o fatorial:");
trem numero: int;
escuta(numero);

trem fat: int = fatorial(numero);
prosa("O fatorial de " + numero + " é " + fat);

trem cafe: int = 3;
enquantim (cafe > 0) {
    prosa("ainda tem " + cafe + " xícara de café");
    cafe--;
}
prosa("acabou o café, trem bão demais!");
