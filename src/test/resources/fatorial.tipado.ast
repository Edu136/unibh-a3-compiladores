Program
  FuncDecl fatorial(n: int): int
    Block
      VarDecl resultado: int
        IntLit 1 : int
      For
        Init
          VarDecl i: int
            IntLit 1 : int
        Cond
          Binary <= : bool
            Var i : int
            Var n : int
        Passo
          Assign i
            Binary + : int
              Var i : int
              IntLit 1 : int
        Block
          Assign resultado
            Binary * : int
              Var resultado : int
              Var i : int
      Return
        Var resultado : int
  Print
    StringLit "Digite um número para calcular o fatorial:" : string
  VarDecl numero: int
  Input numero
  VarDecl fat: int
    Call fatorial : int
      Var numero : int
  Print
    Binary + : string
      Binary + : string
        Binary + : string
          StringLit "O fatorial de " : string
          Var numero : int
        StringLit " é " : string
      Var fat : int
